      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "max(last_over_time(mlops_drift_psi_aggregate[2m]))",
          "legendFormat": "aggregate PSI",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "topk(5, max by (feature) (last_over_time(mlops_feature_drift_psi[2m])))",
          "legendFormat": "{{feature}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Drift — PSI (aggregate + top features)",
      "description": "FR-19 / FR-20 / FR-22: PSI vs. training baseline. Thresholds: 0.10 moderate, 0.25 significant.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
